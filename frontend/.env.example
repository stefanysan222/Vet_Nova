# ─── API Backend ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000

# ─── JWT (solo servidor — NO usar prefijo NEXT_PUBLIC_) ───────────────────────
# Debe ser EXACTAMENTE el mismo secreto que usa el backend (NestJS) para firmar
# los JWT con HS256. El middleware lo usa para verificar la firma del token.
JWT_SECRET=your-shared-hs256-secret

# ─── Google OAuth ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── Google Maps (Places Autocomplete + mapa de ubicación de clínicas) ────────
# Habilita el autocompletado de direcciones y la vista previa del mapa al
# registrar/editar una clínica. Crear la key en https://console.cloud.google.com/
# con las APIs "Maps JavaScript API" y "Places API" habilitadas.
# Si se deja vacía, los componentes degradan a un input de texto simple y un
# placeholder en vez de fallar.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Gmail (solo servidor — NO usar prefijo NEXT_PUBLIC_) ─────────────────────
# Mismas credenciales que usa el backend para el correo de recuperación de contraseña.
# Generar la contraseña de aplicación en https://myaccount.google.com/apppasswords
GMAIL_USER="correo@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# ─── Cloudinary (solo servidor — NO usar prefijo NEXT_PUBLIC_) ────────────────
# https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Upstash Redis (rate limiting persistente en producción) ──────────────────
# Crear base de datos gratuita en https://console.upstash.com/
# Sin estas variables el rate limiting cae a Map en memoria (solo válido en dev)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here
